# 复制成 .env 后填入自己的值（.env 已被 .gitignore 挡住，绝不会进仓库）
#
# 开发用；打包版从 %APPDATA%\catgirl\config.json 读，不看这个文件。

DEEPSEEK_API_KEY=sk-在这里填你的密钥
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_TEMPERATURE=0.6
REQUEST_TIMEOUT=60

# 联网检索：默认用 DeepSeek 官方 Search/Fetch API（复用上面的 Key，按成功请求计费，
# 约 5 元 / 1000 次；失败或空结果自动降级 Bing）。
# 也可显式切到 Brave（需另配 Key）：
# WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_API_KEY=
